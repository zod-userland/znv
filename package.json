{
  "name": "znv",
  "version": "0.5.0",
  "description": "Parse your environment with Zod schemas",
  "license": "MIT",
  "keywords": [
    "env",
    "process.env",
    "zod",
    "validation"
  ],
  "author": "s <https://github.com/lostfictions>",
  "contributors": [
    "David Heidrich (https://github.com/bowlingx)"
  ],
  "homepage": "https://github.com/zod-userland/znv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zod-userland/znv.git"
  },
  "bugs": {
    "url": "https://github.com/zod-userland/znv/issues"
  },
  "type": "module",
  "main": "dist-cjs/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist/",
    "dist-cjs/"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist-cjs/compat.d.ts",
        "default": "./dist-cjs/compat.js"
      }
    }
  },
  "scripts": {
    "build": "run-s -l \"build:*\"",
    "build:clean": "rm -rf dist/ dist-cjs/",
    "build:mjs": "tsc --project tsconfig.build.json",
    "build:cjs": "tsc --project tsconfig.cjs.build.json",
    "build:copy": "cp package.cjs.json dist-cjs/package.json",
    "test": "run-p -cl \"test:*\"",
    "test:ts": "tsc --noEmit",
    "test:oxlint": "oxlint --deny-warnings --report-unused-disable-directives src",
    "test:vitest": "vitest run --dir src",
    "test:oxfmt": "oxfmt --check src",
    "test:attw": "attw . --pack --profile node16",
    "oxfmt": "oxfmt src",
    "vitest": "vitest --dir src",
    "prepublishOnly": "run-s -l build test"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.19.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "super-release": "^1.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
